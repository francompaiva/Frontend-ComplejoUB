# ==============================================================================
# COMPLEJO DEPORTIVO UB - FRONTEND (VARIABLES DE ENTORNO)
# Copia este archivo a ".env" en la raíz de Frontend-ComplejoUB:
#   cp .env.example .env
# ==============================================================================

# URL base del Backend en la nube (ej. Render, Railway) o proxy local en desarrollo
# En desarrollo local por defecto se utiliza '/api/v1' mediante el proxy de Vite
VITE_API_URL=http://localhost:4000/api/v1

# Correo electrónico predeterminado para el formulario de login (Opcional)
VITE_DEMO_CLIENT_EMAIL=lucas@gmail.com

# Contraseña opcional para modo demo local (Opcional, sin secretos en repositorio)
# VITE_DEMO_PASSWORD=tu_contrasena_de_prueba
