# ==============================================================================
# COMPLEJO DEPORTIVO UB - FRONTEND (VARIABLES DE ENTORNO)
# Copiar este archivo a ".env" (desarrollo) o cargar las variables en el panel
# de Vercel (Project Settings > Environment Variables) para producción.
# NUNCA se deben guardar contraseñas en este archivo ni en el código fuente.
# ==============================================================================

# ------------------------------------------------------------------------------
# URL pública de la API REST del backend (OBLIGATORIA en producción / Vercel)
# Ejemplo: https://<tu-servicio>.up.railway.app/api/v1
# En desarrollo puede dejarse vacía: se usa "/api/v1" a través del proxy de Vite.
# ------------------------------------------------------------------------------
VITE_API_URL=

# ------------------------------------------------------------------------------
# Destino del proxy de Vite (solo desarrollo local, "npm run dev")
# Ejemplo: http://localhost:4000
# ------------------------------------------------------------------------------
VITE_DEV_PROXY_TARGET=

# ------------------------------------------------------------------------------
# Perfiles de acceso rápido (OPCIONALES)
# Solo autocompletan el CORREO en el login; la contraseña siempre la ingresa
# el usuario. Si se dejan vacíos, el panel de acceso rápido no se muestra.
# ------------------------------------------------------------------------------
VITE_DEMO_EMAIL_CLIENTE_1=
VITE_DEMO_EMAIL_CLIENTE_2=
VITE_DEMO_EMAIL_SUPERADMIN=
VITE_DEMO_EMAIL_ADMIN=
VITE_DEMO_EMAIL_ARBITRO=
VITE_DEMO_EMAIL_SANCIONADO=
